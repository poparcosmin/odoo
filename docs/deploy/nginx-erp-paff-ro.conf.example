# nginx config for erp.paff.ro
# Add to: /etc/nginx/sites-available/erp.paff.ro
# Enable:  ln -s /etc/nginx/sites-available/erp.paff.ro /etc/nginx/sites-enabled/
#
# Presupuneri:
#   - SSL gestionat de certbot (let's encrypt)
#   - Odoo container expune 127.0.0.1:8310 (HTTP) + 127.0.0.1:8312 (longpolling)
#   - VPS Ubuntu 24, nginx ≥ 1.18 (default Ubuntu 24)
#
# Vezi: docs/runbooks/deploy-vps.md pentru workflow complet

upstream paff_odoo_http {
    server 127.0.0.1:8310;
}

upstream paff_odoo_longpolling {
    server 127.0.0.1:8312;
}

# ─── HTTP → HTTPS redirect ───────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name erp.paff.ro;

    # Let's Encrypt challenge (ACME http-01) — păstrăm pentru renewal
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── HTTPS — main site ───────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;
    server_name erp.paff.ro;

    # ─── SSL ──────────────────────────────────────────────────────────
    ssl_certificate     /etc/letsencrypt/live/erp.paff.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp.paff.ro/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling        on;
    ssl_stapling_verify on;

    # ─── Security headers ─────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # ─── Limits ───────────────────────────────────────────────────────
    client_max_body_size  256M;     # uploads PDF facturi, imagini produse
    proxy_connect_timeout 600s;
    proxy_send_timeout    600s;
    proxy_read_timeout    600s;
    send_timeout          600s;
    keepalive_timeout     65s;

    # ─── Logging ──────────────────────────────────────────────────────
    access_log /var/log/nginx/erp.paff.ro.access.log;
    error_log  /var/log/nginx/erp.paff.ro.error.log;

    # ─── Compression ──────────────────────────────────────────────────
    gzip            on;
    gzip_min_length 1100;
    gzip_buffers    4 32k;
    gzip_types      text/css text/scss text/plain text/xml application/xml application/json application/javascript;
    gzip_vary       on;

    # ─── WebSocket → Odoo longpolling ────────────────────────────────
    location /websocket {
        proxy_pass http://paff_odoo_longpolling;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_redirect off;
    }

    # ─── Odoo HTTP main ──────────────────────────────────────────────
    location / {
        proxy_pass http://paff_odoo_http;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_redirect off;
        proxy_buffering off;

        # By default, do not redirect HTTP/HTTPS — let Odoo handle internally
        proxy_cookie_flags session_id samesite=lax secure;
    }

    # ─── Static assets caching (long-lived) ───────────────────────────
    location ~* /web/static/ {
        proxy_cache_valid 200 90m;
        proxy_buffering   on;
        expires           864000;        # 10 days
        proxy_pass http://paff_odoo_http;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ─── /web/database/manager — restricted by IP (UNCOMMENT to enable) ──
    # location /web/database/ {
    #     allow 1.2.3.4;       # admin IP
    #     deny all;
    #     proxy_pass http://paff_odoo_http;
    #     # ... include same proxy headers as / location above
    # }
}

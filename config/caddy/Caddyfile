# Caddy reverse proxy pentru erp.paff.ro
# Documentat în docs/runbooks/deploy-erp-paff-ro.md (TBD)
#
# Features:
#   - HTTPS automat via Let's Encrypt (zero config)
#   - HTTP → HTTPS redirect forțat
#   - HSTS preload-ready
#   - WebSocket pentru Odoo longpolling
#   - Security headers (CSP, X-Frame, X-Content-Type)
#   - Logging pentru audit trail

erp.paff.ro {
    encode gzip zstd

    # ─── Security headers ─────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # Odoo necesită inline scripts pentru runtime — adjust dacă Odoo 19 acceptă nonce
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'"
        # Remove server fingerprinting
        -Server
    }

    # ─── WebSocket pentru Odoo longpolling (chat, notificări) ─
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets odoo:8072

    # ─── HTTP traffic standard ────────────────────────────────
    reverse_proxy odoo:8069 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
    }

    # ─── Logging (audit trail) ────────────────────────────────
    log {
        output file /var/log/caddy/erp.paff.ro.log {
            roll_size 100mb
            roll_keep 14
            roll_keep_for 168h
        }
        format json
    }

    # ─── Endpoint /web/database/manager — restricted by IP ────
    # Comentează sau ajustează lista la adresele tale admin
    @db_manager path /web/database/*
    handle @db_manager {
        # @allowed_admin remote_ip 1.2.3.4 5.6.7.8
        # respond @allowed_admin "OK"
        # respond 403 "Database manager restricted"
        reverse_proxy odoo:8069
    }
}

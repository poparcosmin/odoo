# PAFF Odoo — environment template
# Copy to `.env` la rădăcina repo-ului și completează valorile reale.
# `.env` e gitignored. NU comite valori reale niciodată.
#
# Generare valori sigure:
#   openssl rand -base64 32

#─────────────────────────────────────────────────────────────────────────
# PostgreSQL connection
#─────────────────────────────────────────────────────────────────────────
ODOO_DB_HOST=postgres
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo_user
ODOO_DB_PASSWORD=__SCHIMBA_AICI__
ODOO_DB_NAME=paff_prod

#─────────────────────────────────────────────────────────────────────────
# Odoo runtime
#─────────────────────────────────────────────────────────────────────────
ODOO_MASTER_PASSWORD=__GENEREAZA_CU_OPENSSL__
ODOO_WORKERS=4
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200

#─────────────────────────────────────────────────────────────────────────
# Ports (host-side)
#─────────────────────────────────────────────────────────────────────────
ODOO_EXTERNAL_PORT=8310
ODOO_LONGPOLLING_PORT=8312

#─────────────────────────────────────────────────────────────────────────
# External APIs
#─────────────────────────────────────────────────────────────────────────
ANAF_API_URL=https://webservicesp.anaf.ro/PlatitorTvaRest/api/v9/ws/tva
ANAF_SPV_CERT_PATH=/etc/odoo/certs/anaf-spv.p12
ANAF_SPV_CERT_PASSWORD=__SCHIMBA_AICI__

MEDUSA_API_URL=http://medusa:9000
MEDUSA_API_KEY=__SCHIMBA_AICI__
MEDUSA_WEBHOOK_SECRET=__SCHIMBA_AICI__

#─────────────────────────────────────────────────────────────────────────
# Caddy / Public exposure
#─────────────────────────────────────────────────────────────────────────
PUBLIC_DOMAIN=erp.paff.ro
CADDY_EMAIL=__EMAIL_LETSENCRYPT__

#─────────────────────────────────────────────────────────────────────────
# Backup
#─────────────────────────────────────────────────────────────────────────
BACKUP_OFFSITE_HOST=
BACKUP_OFFSITE_PATH=
BACKUP_ENCRYPTION_KEY=__GENEREAZA_CU_OPENSSL__

#─────────────────────────────────────────────────────────────────────────
# Alerting (cron-monitor → Telegram + GitHub)
#─────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=__SCHIMBA_AICI__
TELEGRAM_CHAT_ID=__SCHIMBA_AICI__
GITHUB_TOKEN_FOR_AUTO_ISSUES=__PAT_CU_REPO_SCOPE__
